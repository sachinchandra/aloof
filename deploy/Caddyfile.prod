# Production edge: real certificates from Let's Encrypt (ZeroSSL fallback), issued on demand per hostname (HTTP-01/TLS-ALPN-01),
# gated by the control plane's /v1/tls/ask so only known hosts get certs. deploy/golive.sh renders this into data/Caddyfile.live:
# __GLOBAL__ becomes the optional ACME email, and the __SITE__ block is repeated for PAAS_BASE_DOMAIN and each of PAAS_ALT_DOMAINS
# (e.g. 203-0-113-10.sslip.io so the platform has working HTTPS before DNS exists).
# DNS for aloof.si: A aloof.si, www, api, mcp, * -> edge IP
{
	__GLOBAL__
	on_demand_tls {
		ask http://127.0.0.1:8000/v1/tls/ask
	}
}
# Security headers for the platform hosts only (never user apps on the https:// catch-all). CSP for HTML is set by the app.
(aloof_sec) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
# __SITE__ begin
__D__ {
	import aloof_sec
	reverse_proxy 127.0.0.1:8000
}
www.__D__ {
	import aloof_sec
	redir https://__D__{uri} permanent
}
api.__D__ {
	import aloof_sec
	reverse_proxy 127.0.0.1:8000
}
mcp.__D__ {
	import aloof_sec
	# Glama directory ownership claim (exact body, public)
	handle /.well-known/glama.json {
		header Content-Type application/json
		respond `{
  "$schema": "https://glama.ai/mcp/schemas/connector.json",
  "claim": "glama_claim_gXmGq7LWR56x3FwGOK_LvkHq-tnRnOWL"
}
` 200
	}
	handle {
		reverse_proxy 127.0.0.1:8001
	}
}
# __SITE__ end
https:// {
	tls {
		on_demand
	}
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Forwarded-Proto https
	}
}
http:// {
	reverse_proxy 127.0.0.1:8000
}
