[Unit]
Description=Aloof: block cloud metadata (169.254.169.254) for containers and the host
# Independent of how dockerd is run (supervisord here): re-applies the DOCKER-USER rule every 10 s
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/aloof-metadata-block.sh watch
ExecStopPost=/usr/local/sbin/aloof-metadata-block.sh stop
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
