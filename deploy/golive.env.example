# Go-live settings for aloof.si. Copy to deploy/golive.env (git-ignored) and fill in. Then either:
#   python3 deploy/hetzner_golive.py   (from your laptop: creates the Hetzner CX33 edge, installs everything, runs golive.sh)
#   or, on an existing edge server: deploy/golive.sh
# PAAS_EDGE_IPS / PAAS_WG_ENDPOINT placeholders are filled with the server IP by hetzner_golive.py.
PAAS_BRAND=Aloof
PAAS_BASE_DOMAIN=aloof.si
PAAS_API_HOST=api.aloof.si
PAAS_MCP_HOST=mcp.aloof.si
PAAS_PUBLIC_API_URL=https://api.aloof.si
PAAS_PUBLIC_MCP_URL=https://mcp.aloof.si/mcp
MCP_PUBLIC_URL=https://mcp.aloof.si
PAAS_PROXY_URL=https://aloof.si
# Before DNS exists: also serve <ip-dashed>.sslip.io (hetzner_golive.py fills __EDGE_IP_DASHED__) and show those URLs:
# PAAS_ALT_DOMAINS=__EDGE_IP_DASHED__.sslip.io   PAAS_URL_DOMAIN=__EDGE_IP_DASHED__.sslip.io
PAAS_EDGE_IPS=<edge server public IPv4>
ACME_EMAIL=<ops email for Let's Encrypt>
PAAS_WG_ENDPOINT=<edge public IPv4>:51820
PAAS_NODE_API_URL=https://api.aloof.si
PAAS_REGISTRY_NODE=10.88.0.1:5000

# ---- secrets: keep out of git; supervisord/systemd EnvironmentFile with 0600 ----
# PAAS_ADMIN_TOKEN=            # or data/admin_token (auto-created on the box)
# PAAS_SECRET_KEY=             # or data/secret.key (auto-created). Rotate: "new,old" + scripts/rotate_secret_key.py
# PAAS_DB_URL=                 # or data/database_url (deploy/setup-box.sh creates Postgres 16)

# Stripe (primary payments, USD). Dashboard -> Developers -> API keys; Webhooks -> https://api.aloof.si/v1/billing/stripe/webhook
# events: checkout.session.completed, checkout.session.async_payment_succeeded, invoice.paid,
#         customer.subscription.updated, customer.subscription.deleted
# Products -> create "Aloof Hobby" $5/mo and "Aloof Pro" $20/mo recurring prices (tax behavior: exclusive) and paste their ids.
STRIPE_SECRET_KEY=<sk_live_...>
STRIPE_WEBHOOK_SECRET=<whsec_...>
STRIPE_PRICE_HOBBY=<price_...>
STRIPE_PRICE_PRO=<price_...>
# Stripe Tax (VAT/GST/sales tax on Checkout + invoices). Turn on after registering tax IDs in Stripe -> Tax.
STRIPE_TAX=1
# Enable the Stripe customer portal in Dashboard -> Settings -> Billing -> Customer portal.

# Seller details (legal entity shown on invoices; also used by the optional INR invoices)
PAAS_SELLER_NAME=<legal entity name>
PAAS_SELLER_ADDRESS=<registered address>

# Optional: Razorpay INR/UPI top-ups for Indian customers (off by default)
PAAS_RAZORPAY_ENABLED=0
# RAZORPAY_KEY_ID=      RAZORPAY_KEY_SECRET=      RAZORPAY_WEBHOOK_SECRET=
# PAAS_SELLER_GSTIN=    PAAS_SELLER_STATE=        (webhook: https://api.aloof.si/v1/billing/razorpay/webhook)

# Margin floor inputs: worst-case FX for converting INR costs to USD, and payment fee assumptions
PAAS_COST_USD_INR=83
# PAAS_MIN_MARGIN=0.30  PAAS_FEE_PCT=0.029  PAAS_FEE_INTL_PCT=0.015  PAAS_FEE_FIXED_USD=0.30  PAAS_FEE_TAX_PCT=0.005  PAAS_MIN_TOPUP_USD=10

# Email (magic links). Without SMTP_HOST mail is written to data/outbox.log
SMTP_HOST=<smtp host>
SMTP_PORT=587
SMTP_USER=<...>
SMTP_PASSWORD=<...>
MAIL_FROM="Aloof <no-reply@aloof.si>"

# ---- Compute, phase 1: CPU on Hetzner Cloud (EU) ----
# Hetzner Console -> your project -> Security -> API tokens -> Generate (Read & Write). Used for the edge server and CPU nodes.
HCLOUD_TOKEN=<hetzner cloud api token>
HCLOUD_LOCATION=fsn1            # fsn1 Falkenstein, nbg1 Nuremberg (DE), hel1 Helsinki (FI); others are tried if one is full
# HCLOUD_EDGE_TYPE=cx33          # control plane + edge;  CPU nodes: PAAS_HETZNER_PLAN_CPU_NODE=cx43 (default)
# PAAS_SSH_ALLOW_CIDR=203.0.113.4/32   # restrict SSH to your IP (edge + nodes); default edge allows any, nodes none
# CPU pools in order; the 30% margin floor refuses any plan/pool under it (hetzner-cpx only takes perf-* plans, E2E only when its keys are set)
PAAS_CPU_POOLS=hetzner,hetzner-cpx,e2e

# ---- Compute, phase 2: GPUs (off until 10 paid customers; GET /v1/admin/metrics shows the count) ----
PAAS_GPU_ENABLED=0
HYPERSTACK_API_KEY=""            # console.hyperstack.cloud -> API keys (A100/H100/L40 VMs)
HYPERSTACK_ENVIRONMENT=""        # environment name created in the Hyperstack console (picks the region)
# HYPERSTACK_KEY_NAME=           # optional SSH key name in Hyperstack
RUNPOD_API_KEY=""                # runpod.io -> Settings -> API keys (L4 / RTX 4090 pods)
# PAAS_PUBLIC_REGISTRY=          # registry Runpod can pull git builds from (e.g. ghcr.io/you); RUNPOD_REGISTRY_AUTH_ID=

# ---- Optional legacy/overflow providers (India) ----
E2E_API_KEY=""
E2E_AUTH_TOKEN=""
E2E_PROJECT_ID=""
E2E_LOCATION=Delhi
# PAAS_E2E_PLAN_GPU_L4=   PAAS_E2E_PLAN_GPU_A100=   PAAS_E2E_PLAN_GPU_H100=
JARVISLABS_TOKEN=""
JARVISLABS_REGION=india-noida-01
# Krutrim / AWS Mumbai spot: KRUTRIM_* and AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (see paas/drivers/providers.py)
# only used to convert legacy INR balances / Razorpay payments to USD
PAAS_USD_INR=88

# Canonical site on www.<base> (apex redirects to www if/when its A record exists)
# PAAS_CANONICAL_WWW=1   PAAS_SITE_URL=https://www.aloof.si
# Single contact address shown on the site/legal pages/docs and set as Reply-To on every email
PAAS_CONTACT_EMAIL=sachin@aloof.si
