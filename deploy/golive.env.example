# Go-live settings for aloof.si. Copy to deploy/golive.env (git-ignored), fill in, then run deploy/golive.sh
PAAS_BRAND=Aloof
PAAS_BASE_DOMAIN=aloof.si
PAAS_API_HOST=api.aloof.si
PAAS_MCP_HOST=mcp.aloof.si
PAAS_PUBLIC_API_URL=https://api.aloof.si
PAAS_PUBLIC_MCP_URL=https://mcp.aloof.si/mcp
MCP_PUBLIC_URL=https://mcp.aloof.si
PAAS_PROXY_URL=https://aloof.si
PAAS_EDGE_IPS=<edge server public IPv4>
ACME_EMAIL=<ops email for Let's Encrypt>
PAAS_WG_ENDPOINT=<edge public IPv4>:51820
PAAS_NODE_API_URL=https://api.aloof.si
PAAS_REGISTRY_NODE=10.88.0.1:5000

# ---- secrets: keep out of git; supervisord/systemd EnvironmentFile with 0600 ----
# PAAS_ADMIN_TOKEN=            # or data/admin_token (auto-created on the box)
# PAAS_SECRET_KEY=             # or data/secret.key (auto-created). Rotate: "new,old" + scripts/rotate_secret_key.py
# PAAS_DB_URL=                 # or data/database_url (deploy/setup-box.sh creates Postgres 16)

# Stripe (primary payments, USD). Dashboard -> Developers -> API keys; Webhooks -> https://api.aloof.si/v1/billing/stripe/webhook
# events: checkout.session.completed, checkout.session.async_payment_succeeded, invoice.paid,
#         customer.subscription.updated, customer.subscription.deleted
# Products -> create "Aloof Hobby" $5/mo and "Aloof Pro" $20/mo recurring prices (tax behavior: exclusive) and paste their ids.
STRIPE_SECRET_KEY=<sk_live_...>
STRIPE_WEBHOOK_SECRET=<whsec_...>
STRIPE_PRICE_HOBBY=<price_...>
STRIPE_PRICE_PRO=<price_...>
# Stripe Tax (VAT/GST/sales tax on Checkout + invoices). Turn on after registering tax IDs in Stripe -> Tax.
STRIPE_TAX=1
# Enable the Stripe customer portal in Dashboard -> Settings -> Billing -> Customer portal.

# Seller details (legal entity shown on invoices; also used by the optional INR invoices)
PAAS_SELLER_NAME=<legal entity name>
PAAS_SELLER_ADDRESS=<registered address>

# Optional: Razorpay INR/UPI top-ups for Indian customers (off by default)
PAAS_RAZORPAY_ENABLED=0
# RAZORPAY_KEY_ID=      RAZORPAY_KEY_SECRET=      RAZORPAY_WEBHOOK_SECRET=
# PAAS_SELLER_GSTIN=    PAAS_SELLER_STATE=        (webhook: https://api.aloof.si/v1/billing/razorpay/webhook)

# Margin floor inputs: worst-case FX for converting INR costs to USD, and payment fee assumptions
PAAS_COST_USD_INR=83
# PAAS_MIN_MARGIN=0.30  PAAS_FEE_PCT=0.029  PAAS_FEE_INTL_PCT=0.015  PAAS_FEE_FIXED_USD=0.30  PAAS_FEE_TAX_PCT=0.005  PAAS_MIN_TOPUP_USD=10

# Email (magic links). Without SMTP_HOST mail is written to data/outbox.log
SMTP_HOST=<smtp host>
SMTP_PORT=587
SMTP_USER=<...>
SMTP_PASSWORD=<...>
MAIL_FROM=Aloof <no-reply@aloof.si>

# Compute providers: each pool activates when its keys are set (GET /v1/providers shows status)
E2E_API_KEY=""
E2E_AUTH_TOKEN=""
E2E_PROJECT_ID=""
E2E_LOCATION=Delhi
# E2E GPU plan strings (find with E2EProvisioner().list_plans()), e.g.:
# PAAS_E2E_PLAN_GPU_L4=   PAAS_E2E_PLAN_GPU_A100=   PAAS_E2E_PLAN_GPU_H100=
JARVISLABS_TOKEN=""
JARVISLABS_REGION=india-noida-01
KRUTRIM_API_KEY=                # or KRUTRIM_EMAIL + KRUTRIM_PASSWORD
KRUTRIM_REGION=
KRUTRIM_VPC_ID=""
KRUTRIM_SUBNET_ID=""
KRUTRIM_SECURITY_GROUP=""
KRUTRIM_SSHKEY_NAME=""
KRUTRIM_IMAGE_KRN=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# optional: PAAS_AWS_SUBNET_ID, PAAS_AWS_SECURITY_GROUP_IDS, PAAS_AWS_KEY_NAME
# CPU on E2E only: Krutrim/AWS CPU are under the margin floor and get refused anyway
PAAS_CPU_POOLS=e2e
# only used to convert legacy INR balances / Razorpay payments to USD
PAAS_USD_INR=88
