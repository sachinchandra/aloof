        if pat[i:i+3] == "**/": out += "(?:.*/)?"; i += 3; continue
        if pat[i:i+2] == "**": out += ".*"; i += 2; continue
        out += "[^/]*" if c == "*" else "[^/]" if c == "?" else _re.escape(c); i += 1
