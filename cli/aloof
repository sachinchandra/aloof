            else: counts["web"] = int(x)
        pj(call("POST", f"/v1/apps/{name}/scale/count", {"counts": counts}))
    elif a[0] == "vm":
        if len(a) < 2: sys.exit("aloof scale vm <plan> [-a app] [--group worker]")
        r = call("POST", f"/v1/apps/{app_of(o)}/scale/vm", {"plan": a[1], "group": o.group}); print("redeploying on", a[1])
    elif len(a) == 2: pj(call("POST", f"/v1/apps/{a[0]}/scale", {"instances": int(a[1])}))
    elif len(a) == 1 and a[0].isdigit(): pj(call("POST", f"/v1/apps/{app_of(o)}/scale", {"instances": int(a[0])}))
