def warn_local_api(api=None, src=None, out=sys.stderr):
    """Warn when the API URL points at this machine and came from env/config (a leftover dev setting)."""
    import urllib.parse as _u
    api = api or API; src = src if src is not None else _api_source()
    h = (_u.urlsplit(api).hostname or "").lower()
