        print("deploying", r["app"]["name"], "from template", r["template"])
        for k, v in (r.get("generated_secrets") or {}).items():
            print(f"generated {k}={v}  " + ("(shown once and NOT stored: save it now)" if k == "ADMIN_LOGIN" else "(shown once; also in the app env)"))
        if o.no_wait: return
        r = wait_deploy(name, t0); print(r.get("error") or f"live: {r['url']}")
        if r["status"] == "failed": sys.exit(1)
        return
    cfg = load_toml(os.path.join(o.dir, o.config) if not os.path.isabs(o.config) else o.config)
    name = o.app_opt or o.name or cfg.get("app")
    if not name: sys.exit("app name? `aloof deploy <name>` or set app = \"...\" in aloof.toml (aloof launch creates one)")
    env = dict(e.split("=", 1) for e in o.env)
    if cfg or not (o.image or o.git):
