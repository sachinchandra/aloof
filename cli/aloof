def dockerignore(root):
    """Docker semantics: patterns in order, last match wins, `!` re-includes. Without a .dockerignore, .git is skipped."""
    pats = []; f = os.path.join(root, ".dockerignore")
    if os.path.exists(f):
        for line in open(f):
            line = line.strip()
            if not line or line.startswith("#"): continue
            neg = line.startswith("!"); pats.append((neg, _ignore_rx(line[1:] if neg else line)))
    else: pats = [(False, _ignore_rx(".git"))]
    def ignored(rel):
        r = False
        for neg, rx in pats:
            if rx.match(rel): r = not neg
        return r
    ignored.has_neg = any(n for n, _ in pats)
    return ignored
def tar_context(root):
    import tarfile, io
    root = os.path.abspath(root); ign = dockerignore(root); buf = io.BytesIO(); n = 0
    with tarfile.open(fileobj=buf, mode="w:gz") as t:
        for d, dirs, files in os.walk(root):
