def upload(name, data):
    req = urllib.request.Request(f"{API}/v1/apps/{name}/source", method="POST", data=data, headers={"Content-Type": "application/gzip", "User-Agent": UA, "Authorization": f"Bearer {KEY}"})
    try: return json.loads(urllib.request.urlopen(req, timeout=600).read())
    except urllib.error.HTTPError as e: sys.exit(f"upload failed {e.code}: {e.read().decode()}")
def wait_deploy(name, t0, timeout=600):
    seen = set(); end = time.time() + timeout
    while True:
        if time.time() > end:
            sys.exit(f"still deploying after {timeout // 60} min; stopped waiting (the deploy continues on the server). Check `aloof status {name}` and `aloof logs {name}`.")
        time.sleep(2)
        ev = call("GET", f"/v1/apps/{name}/logs?tail=0", raw=True).split("== instance")[0].splitlines()[1:]
        for e in ev:
            if e not in seen: seen.add(e); print("  " + e, flush=True)
        rel = (call("GET", f"/v1/apps/{name}/releases") or [{}])[0]
        if rel.get("created", 0) >= t0 - 2 and rel.get("status") in ("active", "failed"): break
    return call("GET", f"/v1/apps/{name}")
def cmd_deploy(o):
