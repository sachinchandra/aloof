        if o.port: cfg.setdefault("http_service", {})["internal_port"] = o.port
        if o.instances is not None: cfg.setdefault("scale", {})["count"] = o.instances
        if o.region: cfg["primary_region"] = o.region
        body = {"config": cfg, "env": env}
        b = cfg.get("build") or {}
