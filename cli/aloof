        fix = f"unset {src[4:]}" if src.startswith("env ") else f'remove "api" from {src} (or set it to {DEFAULT_API})'
        print(f"warning: using API {api} from {src}; this is a local dev server, not Aloof. To use {DEFAULT_API}: {fix}", file=out)
        return True
    return False
