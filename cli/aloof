        t0 = time.time(); r = call("POST", "/v1/apps", {"name": name, "source": src, **({"plan": o.plan} if o.plan else {}), "port": o.port or 8080, "instances": 1 if o.instances is None else o.instances, "env": env, **({"region": o.region} if o.region else {})})
    print("deploying", r["name"], "on", r["provider"])
    if o.no_wait: return
    r = wait_deploy(name, t0)
    print(r.get("error") or f"live: {r['url']}")
    if r["status"] == "failed": sys.exit(1)
def cmd_status(o):
    st = call("GET", f"/v1/apps/{app_of(o)}/status")
    rel = st.get("release") or {}
    print(f"{st['name']}  {st['status']}  {st['url']}  plan={st['plan']}  on {st['provider']}")
    if rel: print(f"release v{rel['version']} {rel['status']}  {rel.get('image') or ''}")
    if st.get("error"): print("error:", st["error"])
    for g in st["process_groups"]:
        print(f"  [{g['group']}] {g['count']} running" + (f" ({g['status']})" if g['group'] != 'web' else ""))
        for i in g["instances"]: print(f"     {i['id']:<20} {i['status']:<8} since {time.strftime('%H:%M:%S', time.localtime(i['started']))}")
    for c in st.get("cron") or []: print(f"  cron {c['name']}: {c['schedule']}  {c['command']}")
    if st.get("release_command"): print(f"  release_command: {st['release_command']}")
    print(f"  private: {st['internal_host']}" + (f"   domains: {', '.join(st['domains'])}" if st['domains'] else "") + (f"   previews: {', '.join(st['previews'])}" if st['previews'] else ""))
def cmd_logs(o):
    name = app_of(o)
    if not o.follow: print(call("GET", f"/v1/apps/{name}/logs?tail={o.lines}", raw=True)); return
    since = time.time() - 300
    try:
        while True:
            r = call("GET", f"/v1/apps/{name}/logs/history?since={since}&limit=1000")
            for l in r["lines"]:
                print(time.strftime("%H:%M:%S", time.localtime(l["ts"])), l["instance"][:12], l["message"], flush=True); since = max(since, l["ts"] + 1e-6)
            time.sleep(2)
    except KeyboardInterrupt: pass
